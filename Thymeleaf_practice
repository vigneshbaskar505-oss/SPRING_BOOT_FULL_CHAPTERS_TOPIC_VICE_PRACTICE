package in.main.controller;

import java.util.List;

import org.springframework.stereotype.Controller;
import org.springframework.ui.Model;
import org.springframework.web.bind.annotation.GetMapping;

 
@Controller
//Used When intergrate html pages with java -Thymeleaf
public class EmployeeController {
@GetMapping("/Welcome")
public String welcomepage(Model m) {
	//Model class to connect java based code with html
	m.addAttribute("title","This is my Thymeleaf page");
	m.addAttribute("item",List.of("Springboovicet-Thymeleaf","Repository","Service"));
	return "webpage";
	// this is html file name .
}

<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org">
	<head>
	    <title th:text="${title}">Spring Boot Thymeleaf</title>
		
	</head>
	
	<body>
	    <h1 th:text="${title}">Placeholder Text</h1>
		<ul> 
			<li th:each="item:${item}" th:text="${item}"></li>
		</ul>
	</body>
	</html>



